<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Selftest.Build" Version="1.0.0" />
  </ItemGroup>
  <!-- Restored only by `publish -p:SelftestPublish=true`, as `publish -r <rid>` restores runtime packs. -->
  <ItemGroup Condition="'$(SelftestPublish)' == 'true'">
    <PackageReference Include="Selftest.Publish" Version="1.0.0" />
  </ItemGroup>
</Project>
