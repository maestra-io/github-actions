# Fixture for scripts/test-dotnet-service-build-cache.sh: the GitLab-era pattern that
# writes the packages token into NuGet.Config, i.e. into a cached layer. The test also
# builds this file after scripts/nuget-secret-mount-fix.sh (the pattern callers get).
# --allow-insecure-connections only because the fake feed is plain HTTP (update source
# would drop the nuget.config attribute).
FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /sln
COPY nuget.config App/App.csproj ./
RUN --mount=type=secret,id=PRIVATE_PACKAGES_TOKEN \
	dotnet nuget update source private \
		--username ci \
		--password $(cat /run/secrets/PRIVATE_PACKAGES_TOKEN) \
		--store-password-in-clear-text \
		--allow-insecure-connections
RUN dotnet restore App.csproj
COPY App/ ./
RUN dotnet build App.csproj -c Release --no-restore

FROM build AS publish
RUN dotnet publish App.csproj -c Release -o /dist -p:SelftestPublish=true
