#!/usr/bin/python3
# {{ ansible_managed }}
"""Per-slot WireGuard metrics for the node_exporter textfile collector.

Reads `wg show <iface> dump`, maps each peer's public key to its slot name and
writes handshake time and byte counters. Keys are never written out.
"""
import os
import subprocess
import tempfile

IFACE = {{ wireguard_burst_interface | to_json }}
OUT = {{ (wireguard_burst_textfile_dir ~ '/wireguard_burst.prom') | to_json }}
SLOTS = {{ wireguard_burst_slots | items2dict(key_name='pubkey', value_name='name') | to_json }}
{% raw %}
METRICS = (
    ("wireguard_peer_latest_handshake_seconds", "gauge",
     "Unix time of the latest handshake with the slot's peer, 0 = never.", 4),
    ("wireguard_peer_rx_bytes", "counter", "Bytes received from the slot's peer.", 5),
    ("wireguard_peer_tx_bytes", "counter", "Bytes sent to the slot's peer.", 6),
)


def main():
    dump = subprocess.run(["wg", "show", IFACE, "dump"], capture_output=True,
                          text=True, check=True).stdout.splitlines()[1:]
    rows = {}
    for line in dump:
        fields = line.split("\t")
        if len(fields) >= 8 and fields[0] in SLOTS:
            rows[SLOTS[fields[0]]] = fields
    out = []
    for name, kind, text, col in METRICS:
        out += [f"# HELP {name} {text}", f"# TYPE {name} {kind}"]
        for slot in sorted(rows):
            out.append(f'{name}{{interface="{IFACE}",slot="{slot}"}} {int(rows[slot][col])}')
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(OUT), prefix=".wireguard_burst.")
    with os.fdopen(fd, "w") as fh:
        fh.write("\n".join(out) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)


if __name__ == "__main__":
    main()
{% endraw %}
