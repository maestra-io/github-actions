{# One BFD-tracked /32 per slot through the tunnel. `onlink`: the tunnel holds #}
{# only a /32, the slot address is never connected. #}
{% for s in wireguard_burst_slots %}
ip route {{ s.ip }}/32 {{ s.ip }} {{ wireguard_burst_interface }} onlink bfd profile {{ wireguard_burst_bfd_profile }}
{% if wireguard_burst_mode == 'embedded' %}
{% if wireguard_burst_neighbour_lan_ip | length > 0 %}
ip route {{ s.ip }}/32 {{ wireguard_burst_neighbour_lan_ip }} {{ wireguard_burst_fallback_distance }}
{% endif %}
ip route {{ s.ip }}/32 blackhole 250
{% endif %}
{% endfor %}
