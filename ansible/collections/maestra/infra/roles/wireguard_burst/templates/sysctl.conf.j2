# {{ ansible_managed }}
net.ipv4.ip_forward = 1
# L4 hash: flows to the LAN spread over ECMP paths per connection.
net.ipv4.fib_multipath_hash_policy = 1
# Loose: the reverse path of a slot address is the tunnel only while BFD is up.
net.ipv4.conf.all.rp_filter = 2
net.ipv4.conf.default.rp_filter = 2
